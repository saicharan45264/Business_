{
  "name": "giri-fruits",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch apps/api/src --ext ts --exec ts-node apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.mts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.6"
  },
  "private": true
}
